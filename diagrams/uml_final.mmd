classDiagram
    class Owner {
        +String name
        +Pet[] pets
        +OwnerPreferences preferences
        +add_pet(pet)
        +remove_pet(pet)
        +get_all_tasks()
    }

    class Pet {
        +String name
        +String species
        +int age
        +String breed
        +String health_needs
        +String pet_preferences
        +CareTask[] care_tasks
        +add_task(task)
        +remove_task(task)
        +update_health_needs(health_needs)
        +get_tasks()
    }

    class CareTask {
        +String name
        +String category
        +String description
        +int duration
        +String priority
        +String frequency
        +String deadline
        +String preferred_time
        +bool completed
        +Date due_date
        +mark_complete()
        +mark_incomplete()
        +update_details(details)
        +is_due()
        +fits_time_available(minutes)
        +next_occurrence()
    }

    class OwnerPreferences {
        +int available_time
        +String preferred_task_times
        +String priority_preferences
        +String excluded_activities
        +int maximum_daily_tasks
        +update_preferences(preferences)
        +is_preferred_time(task)
        +allows_task(task)
        +get_available_minutes()
    }

    class DailyPlan {
        +Date plan_date
        +CareTask[] selected_tasks
        +CareTask[] deferred_tasks
        +int total_duration
        +int available_time
        +String explanation
        +add_task(task)
        +remove_task(task)
        +calculate_total_duration()
        +is_within_time_limit()
        +generate_explanation()
        +get_summary()
    }

    class Planner {
        +Date plan_date
        +Owner owner
        +DailyPlan current_plan
        +collect_due_tasks(date_to_plan)
        +prioritize_tasks(tasks)
        +sort_by_time(tasks)
        +filter_tasks(tasks, completed, pet_name)
        +detect_conflicts(tasks)
        +build_daily_plan()
        +defer_task(task)
        +explain_decision(task)
        +complete_task(task)
    }

    Owner "1" *-- "0..*" Pet : owns
    Owner "1" *-- "0..1" OwnerPreferences : has
    Pet "1" *-- "0..*" CareTask : has
    Planner "1" --> "1" Owner : schedules for
    Planner "1" --> "0..1" DailyPlan : creates
    DailyPlan "1" o-- "0..*" CareTask : contains
    CareTask ..> CareTask : creates next occurrence

    note for CareTask "Public alias: Task"
    note for Planner "Public alias: Scheduler"
